{
  "name": "picker-fields-v2",
  "version": "2.0.5",
  "description": "Azure DevOps extension — Multi cascading picker fields control (v2)",
  "scripts": {
    "bump": "node bump-version.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "node bump-version.js && webpack --mode production && tfx extension create --manifest-globs vss-extension.json",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "setup": "node setup-dirs.js",
    "postinstall": "node setup-dirs.js"
  },
  "dependencies": {
    "azure-devops-extension-api": "^1.157.0",
    "azure-devops-extension-sdk": "^4.0.2",
    "azure-devops-ui": "^2.167.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^16.14.62",
    "@types/react-dom": "^16.9.24",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "rimraf": "^5.0.1",
    "sass": "^1.66.1",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "tfx-cli": "^0.16.0",
    "ts-jest": "^29.1.4",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
